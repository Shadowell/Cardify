ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://cardify:replace-me@127.0.0.1:5432/cardify
CARDIFY_STORAGE_ROOT=/opt/cardify/storage
APPLE_CLIENT_ID=com.jiefeng.cardify
SESSION_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
APP_STORE_BUNDLE_ID=com.jiefeng.cardify
APP_STORE_APPLE_ID=replace-with-app-store-connect-numeric-app-id
APP_STORE_ROOT_CERTIFICATES_PATH=/opt/cardify/app-store-root-certificates
APP_STORE_ENABLE_ONLINE_CHECKS=true
APP_STORE_PRODUCT_IDS=com.jiefeng.cardify.pro.monthly,com.jiefeng.cardify.pro.yearly
LEGAL_CONTACT_EMAIL=support@notenap.com
